{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gptibo-shop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "shop.example.invalid", "custom_domain": true}],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "INTEREST_DB",
    "database_name": "gptibo-shop",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    {"name": "INTEREST_LIMITER", "namespace_id": "1001", "simple": {"limit": 30, "period": 60}},
    {"name": "API_LIMITER", "namespace_id": "1002", "simple": {"limit": 120, "period": 60}},
    {"name": "EXPENSIVE_LIMITER", "namespace_id": "1003", "simple": {"limit": 90, "period": 60}}
  ],
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": false},
  "vars": {
    "GRIZZLY_SMS_ENABLED": "false",
    "ORDER_TESTING_ENABLED": "false",
    "EMAIL_PRODUCTS_ENABLED": "false",
    "XGIFT_CHECKOUT_ENABLED": "false",
    "PAYMENT_CHECKOUT_ENABLED": "false",
    "PAYMENT_TEST_ENABLED": "false",
    "ACCOUNT_SUPPLIER_CHECKOUT_ENABLED": "false",
    "XIAOJIU_PURCHASE_ENABLED": "false",
    "DELIVERY_SUPPLIER_CHECKOUT_ENABLED": "false",
    "RECHARGE_CHECKOUT_ENABLED": "false",
    "RECHARGE_READ_ONLY": "true",
    "RECHARGE_COLLECTION_MODE": "platform_collect",
    "RECHARGE_PRODUCT_MAP": "{\"plus\":\"chatgpt_plus_cdk_1m\"}",
    "RECHARGE_NOTIFY_URL": "https://shop.example.invalid/api/recharge/webhook"
  }
}
